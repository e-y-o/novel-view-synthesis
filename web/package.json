{
  "name": "nvs-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "fixtures": "uv run --project .. python ../scripts/make_fixture_assets.py",
    "e2e": "npm run build && playwright test",
    "e2e:chromium": "npm run build && playwright test --project=chromium"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@testing-library/preact": "^3.2.6",
    "@types/node": "^22.20.7",
    "eslint": "^10.16.0",
    "jsdom": "^31.0.1",
    "prettier": "^3.10.1",
    "typescript": "~6.0",
    "typescript-eslint": "^8.74.0",
    "vite": "^8.4.0",
    "vitest": "^5.1.2"
  },
  "dependencies": {
    "@preact/signals": "^2.11.4",
    "preact": "^11.2.0"
  },
  "engines": {
    "node": ">=20"
  }
}
